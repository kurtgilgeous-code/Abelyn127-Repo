# PostgreSQL connection string for the account database.
DATABASE_URL=postgresql://username:password@localhost:5432/tampisawan

# Generated by `npm.cmd --prefix server run admin:create`.
JWT_SECRET=

# Optional production site origin (comma-separated for multiple origins).
# Set to the exact public site origin in production.
APP_ORIGIN=
PORT=5000

# HitPay API key and webhook salt (Developers > API Keys / Webhooks). Keep both private.
# HITPAY_MODE must be "sandbox" or "live" and must match the account the key belongs to.
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=
HITPAY_MODE=sandbox

# Google Gemini API key for the Geraint concierge chat (POST /api/chat). Keep it private.
# GEMINI_MODEL is optional: it is tried first, then gemini-3.5-flash and gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=

# Override the default local payment-proof directory in production.
PAYMENT_PROOF_DIR=
