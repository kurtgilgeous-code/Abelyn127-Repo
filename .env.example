# PostgreSQL connection string for the account database.
DATABASE_URL=postgresql://username:password@localhost:5432/tampisawan

# Generated by `npm.cmd --prefix server run admin:create`.
JWT_SECRET=

# Optional production site origin (comma-separated for multiple origins).
# Render's assigned URL is allowed automatically when APP_ORIGIN is unset.
APP_ORIGIN=
PORT=5000

# Override the default local payment-proof directory in production.
PAYMENT_PROOF_DIR=
